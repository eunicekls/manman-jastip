rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hanya akun tim ManMan (login ID + password), maksimal 7 hari sejak login.
    match /teams/{team}/{col}/{doc} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'manman@gmail.com'
        && request.time.toMillis() / 1000 - request.auth.token.auth_time < 604800
        && team.size() >= 8;
    }
  }
}
